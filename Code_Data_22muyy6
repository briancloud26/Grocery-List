     </div>
     <section data-template-id="comparison-panel" class="canva-panel panel mt-6 rounded-[2rem] p-5 sm:p-7" aria-labelledby="comparison-title" style="background: rgb(255, 255, 255);">
      <div class="flex flex-wrap items-center justify-between gap-3">
       <h3 id="comparison-title" data-template-id="comparison-title-text" class="canva-text font-bold" style="color: rgb(29, 26, 59); font-weight: 700; font-style: normal; font-size: 19px;">From functional to magnetic.</h3>
       <div class="flex items-center gap-3"><button id="difference-button" data-template-id="difference-button" type="button" class="canva-button rounded-full border border-violet-200 px-4 py-2 font-semibold hover:bg-violet-50" style="color: rgb(98, 81, 214); font-weight: 700; font-style: normal; font-size: 16px;">Adjust difference</button> <span id="difference-status" class="text-sm font-semibold text-[#625f78]" aria-live="polite"></span>
       </div>
      </div>
      <div id="comparison-preview" class="comparison is-balanced mt-5 grid gap-4 sm:grid-cols-2">
       <article class="rounded-2xl border border-slate-300 bg-slate-100 p-5">
        <p data-template-id="before-label" class="canva-text font-bold" style="color: rgb(87, 96, 108); font-weight: 700; font-style: normal; font-size: 16px;">Before</p>
        <div class="mt-4 space-y-3 rounded-lg border border-slate-300 bg-white p-5">
         <div class="h-3 w-1/3 rounded bg-slate-300"></div>
         <div class="h-7 w-4/5 rounded bg-slate-300"></div>
         <div class="h-3 w-full rounded bg-slate-200"></div>
         <div class="h-9 w-1/3 rounded bg-slate-400"></div>
        </div>
       </article>
       <article class="comparison-after rounded-2xl bg-[#1c1936] p-5">
        <p data-template-id="after-label" class="canva-text font-bold" style="color: rgb(200, 193, 250); font-weight: 700; font-style: normal; font-size: 16px;">After</p>
        <div class="mt-4 space-y-3 rounded-xl bg-gradient-to-br from-[#7867ee] to-[#3b9df3] p-5">
         <div class="h-3 w-1/3 rounded bg-white/60"></div>
         <div class="h-7 w-4/5 rounded bg-white/90"></div>
         <div class="h-3 w-full rounded bg-white/40"></div>
         <div class="h-9 w-1/3 rounded-lg bg-[#17152b]"></div>
