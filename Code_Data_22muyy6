      </section>
      <section data-template-id="preview-panel" class="canva-panel panel rounded-[2rem] p-5 sm:p-7" aria-labelledby="preview-title" style="background: rgb(255, 255, 255);">
       <h3 id="preview-title" data-template-id="preview-title-text" class="canva-text font-bold" style="color: rgb(29, 26, 59); font-weight: 700; font-style: normal; font-size: 19px;">Your local demo preview</h3>
       <p data-template-id="preview-note" class="canva-text mt-1 text-sm" style="color: rgb(98, 95, 120); font-weight: 400; font-style: normal; font-size: 16px;">A styling illustration, not a fetched website.</p>
       <div id="demo-frame" class="demo-frame mt-5 border border-violet-100 p-5 sm:p-7">
        <div class="flex items-center gap-2 border-b border-current/10 pb-4 font-bold">
         <span class="h-3 w-3 rounded-full" style="background:var(--preview-accent)"></span>Glow Studio
        </div>
        <div class="grid items-center gap-5 py-6 sm:grid-cols-[1fr_.8fr]">
         <div><span class="rounded-full px-3 py-1 text-xs font-bold" style="background:#eeebff;color:var(--preview-accent)">DESIGNED TO FEEL CLEAR</span>
          <h4 class="mt-4 text-2xl font-bold leading-tight">A space for better ideas.</h4>
          <p id="demo-source-label" class="mt-3 leading-relaxed text-[#625f78]">Your local styling demo starts here.</p>
          <div class="mt-4 inline-block rounded-lg px-4 py-2 text-sm font-bold text-white" style="background:var(--preview-accent)">
           Discover the collection
          </div>
         </div>
         <div class="demo-art grid min-h-44 place-items-center overflow-hidden text-6xl text-white" aria-hidden="true">
          ✦
         </div>
        </div>
        <div class="grid grid-cols-3 gap-2 text-center text-xs font-bold">
         <div class="rounded-xl bg-white p-3">
          Clear hierarchy
         </div>
         <div class="rounded-xl bg-white p-3">
          Intentional rhythm
