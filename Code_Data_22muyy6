   </main>
   <footer data-template-id="footer-panel" class="canva-footer border-t border-violet-100 px-5 py-6 text-center" style="background: rgb(255, 255, 255);">
    <p data-template-id="footer-copy" class="canva-text" style="color: rgb(112, 107, 136); font-weight: 400; font-style: normal; font-size: 16px;">A local interactive shape and styling exploration. No external websites are accessed.</p>
   </footer>
  </div>
  <script>
document.addEventListener("DOMContentLoaded", () => {
  const defaults = { triangle:115, length:280, tip:48, angle:-28, color:"#6757e8" };
  const shapeInputs = {
    triangle:document.getElementById("triangle-size"),
    length:document.getElementById("spear-length"),
    tip:document.getElementById("tip-size"),
    angle:document.getElementById("spear-angle"),
    color:document.getElementById("shape-color")
  };
  function drawShape() {
    const size = Number(shapeInputs.triangle.value);
    const length = Number(shapeInputs.length.value);
    const tip = Number(shapeInputs.tip.value);
    const angle = Number(shapeInputs.angle.value);
    const color = shapeInputs.color.value;
    const centerX = 350, centerY = 220;
    const halfBase = size * .91;
    document.getElementById("triangle-fill").setAttribute("points",
      `${centerX},${centerY-size} ${centerX-halfBase},${centerY+size*.72} ${centerX+halfBase},${centerY+size*.72}`);
    const start = -length / 2, point = length / 2, tipBase = point - tip;
    const shaft = document.getElementById("spear-shaft");
    shaft.setAttribute("x1",start);
    shaft.setAttribute("y1",0);
    shaft.setAttribute("x2",tipBase+3);
    shaft.setAttribute("y2",0);
    document.getElementById("spear-end").setAttribute("cx",start);
    document.getElementById("spear-tip").setAttribute("points",
      `${tipBase},${-tip*.39} ${point},0 ${tipBase},${tip*.39}`);
    document.getElementById("spear-assembly").setAttribute("transform",
      `translate(${centerX} ${centerY}) rotate(${angle})`);
    ["triangle-fill","spear-shaft","spear-tip","spear-end"].forEach(id => {
      const el = document.getElementById(id);
      el.setAttribute(id === "triangle-fill" || id === "spear-shaft" ? "stroke" : "fill",color);
    });
    document.getElementById("triangle-size-value").value = size;
    document.getElementById("spear-length-value").value = length;
    document.getElementById("tip-size-value").value = tip;
    document.getElementById("spear-angle-value").value = angle + "°";
    document.getElementById("svg-desc").textContent =
      `A triangle of size ${size} with a spear of length ${length}, a pointed tip of size ${tip}, rotated ${angle} degrees.`;
  }
  Object.values(shapeInputs).forEach(input => input.addEventListener("input",drawShape));
  document.getElementById("reset-shape").addEventListener("click",() => {
    Object.keys(defaults).forEach(key => { shapeInputs[key].value = defaults[key]; });
    drawShape();
  });
  drawShape();

  const root = document.documentElement;
  const paletteInput = document.getElementById("palette-select");
  const typeInput = document.getElementById("type-select");
  const radiusInput = document.getElementById("radius-range");
  const status = document.getElementById("status-message");
  const palettes = {
    violet:["#6757e8","#45a5f6","#f7f7ff","#1d1a3b"],
    ocean:["#097b8c","#3bb9d4","#f2fbfc","#10313a"],
    sunset:["#db5b58","#f1a852","#fff9f4","#3a1f2c"],
    mono:["#232334","#77788d","#fbfbfc","#17171e"]
  };
  const presets = {
    modern:{palette:"violet",type:"sans",radius:18},
    editorial:{palette:"mono",type:"editorial",radius:4},
    playful:{palette:"sunset",type:"sans",radius:28}
  };
  function updatePreview() {
    const [accent,accent2,bg,text] = palettes[paletteInput.value];
    root.style.setProperty("--preview-accent",accent);
    root.style.setProperty("--preview-accent-2",accent2);
    root.style.setProperty("--preview-bg",bg);
    root.style.setProperty("--preview-text",text);
    root.style.setProperty("--preview-radius",radiusInput.value+"px");
    root.style.setProperty("--preview-font",{
      sans:'"DM Sans",sans-serif',editorial:'"Fraunces",serif',mono:'"Space Mono",monospace'
    }[typeInput.value]);
  }
  [paletteInput,typeInput,radiusInput].forEach(input => {
    input.addEventListener("input",updatePreview);
    input.addEventListener("change",updatePreview);
  });
  document.querySelectorAll("[data-preset]").forEach(button => {
    button.addEventListener("click",() => {
      const preset = presets[button.dataset.preset];
      paletteInput.value = preset.palette;
      typeInput.value = preset.type;
      radiusInput.value = preset.radius;
      updatePreview();
      document.querySelectorAll("[data-preset]").forEach(item => {
        const active = item === button;
        item.classList.toggle("is-active",active);
        item.setAttribute("aria-pressed",String(active));
      });
      status.textContent = button.dataset.preset + " styling applied to the local demo.";
    });
  });
  document.getElementById("source-form").addEventListener("submit",event => {
    event.preventDefault();
    const url = document.getElementById("website-url").value.trim();
    const snippet = document.getElementById("html-snippet").value.trim();
    if (!url && !snippet) {
      status.textContent = "Add a website URL or a short HTML snippet to personalize this local demo.";
      return;
    }
    if (url && !/^https?:\/\/.+/i.test(url)) {
      status.textContent = "Enter a complete URL beginning with https:// or use an HTML snippet.";
      return;
    }
    document.getElementById("demo-source-label").textContent = url
      ? "Local styling direction for " + url.replace(/^https?:\/\//i,"").replace(/\/$/,"") + "."
      : "Local styling direction based on your HTML snippet.";
    status.textContent = "Your local preview is ready — no external website was accessed.";
  });
  const differenceStates = ["Subtle","Balanced","Strong"];
  let differenceIndex = 1;
  const differenceButton = document.getElementById("difference-button");
  function updateDifference() {
    const state = differenceStates[differenceIndex];
    const preview = document.getElementById("comparison-preview");
    preview.classList.remove("is-subtle","is-balanced","is-strong");
    preview.classList.add("is-"+state.toLowerCase());
    document.getElementById("difference-status").textContent = state;
    differenceButton.setAttribute("aria-label","Adjust difference. Current level: "+state+".");
  }
  differenceButton.addEventListener("click",() => {
    differenceIndex = (differenceIndex+1)%differenceStates.length;
    updateDifference();
  });
  updatePreview();
  updateDifference();
});
</script>
 
