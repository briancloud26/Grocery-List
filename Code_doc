    .nav-link::after{
      content:"";
      position:absolute;
      left:0; bottom:-6px;
      width:0; height:1px;
      background:var(--ink);
      transition:width .25s ease;
    }
    .nav-link:hover::after{width:100%}
    .hero-img-wrap::before{
      content:"";
      position:absolute;
      inset:18px -18px -18px 18px;
      border:1px solid #b8ab99;
      z-index:0;
    }
    .hero-img-wrap img{position:relative; z-index:1}
    .rise{
      animation:rise .8s ease both;
    }
    .rise.delay-1{animation-delay:.12s}
    .rise.delay-2{animation-delay:.24s}
    .rise.delay-3{animation-delay:.36s}
    @keyframes rise{
      from{opacity:0; transform:translateY(18px)}
      to{opacity:1; transform:translateY(0)}
    }
    .style-card{
      transition:transform .28s ease, box-shadow .28s ease;
    }
    .style-card:hover{
      transform:translateY(-6px);
      box-shadow:0 16px 35px rgba(52,45,35,.12);
    }
    .focus-ring:focus-visible{
      outline:2px solid #5d6b56;
      outline-offset:4px;
    }
    @media (max-width: 768px){
      .hero-img-wrap::before{display:none}
    }
