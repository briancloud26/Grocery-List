<!doctype html>
<html lang="en">
 <head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Grocery List</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&amp;family=Fraunces:wght@600;700&amp;display=swap" rel="stylesheet">
  <style>
        body { font-family: 'DM Sans', sans-serif; }
        .heading-font { font-family: 'Fraunces', serif; }
        .item-done .item-text { text-decoration: line-through; opacity: 0.5; }
    </style>
  <script src="/_sdk/resizing_sdk.js" type="text/javascript"></script>
 </head>
 <body data-template-id="__page-root" class="min-h-screen">
  <header class="w-full px-4 pt-8 pb-4">
   <div class="max-w-lg mx-auto text-center">
    <h1 data-template-id="page-title" class="canva-text heading-font"></h1>
    <p data-template-id="page-subtitle" class="canva-text mt-1"></p>
   </div>
  </header>
  <main class="max-w-lg mx-auto px-4 pb-10"><!-- Add form -->
   <form id="add-form" data-template-id="form-bg" class="canva-card rounded-2xl p-5 mb-6">
    <div class="flex flex-col gap-3">
     <div class="flex gap-2"><input id="item-name" type="text" required data-template-id="input-item" class="canva-input flex-1 px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-emerald-400 text-sm"> <input id="item-qty" type="text" data-template-id="input-qty" class="canva-input w-20 px-3 py-2 rounded-lg border border-gray-300 focus:outline-none focus:ring-2 focus:ring-emerald-400 text-sm">
     </div>
     <div class="flex gap-2"><select id="item-cat" class="flex-1 px-3 py-2 rounded-lg border border-gray-300 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-emerald-400"> <option value="Produce">🥬 Produce</option> <option value="Dairy">🧀 Dairy</option> <option value="Meat">🥩 Meat</option> <option value="Bakery">🍞 Bakery</option> <option value="Frozen">🧊 Frozen</option> <option value="Beverages">🥤 Beverages</option> <option value="Other">📦 Other</option> </select> <button type="submit" data-template-id="add-btn" class="canva-button px-5 py-2 rounded-lg font-medium text-sm flex items-center gap-1"> <i data-lucide="plus" style="width:16px;height:16px"></i> </button>
     </div>
    </div>
   </form>
   <div id="grocery-list" class="space-y-2"></div>
   <p id="empty-state" data-template-id="empty-msg" class="canva-text text-center py-12 hidden"></p>
   <p id="limit-warning" class="text-center text-red-600 font-medium py-2 hidden">Maximum 999 items reached.</p>
  </main>
  <template id="item-tpl">
   <div data-template-id="item-row" class="canva-card flex items-center gap-3 px-4 py-3 rounded-xl group"><button type="button" class="check-btn flex-shrink-0 w-6 h-6 rounded-full border-2 border-emerald-400 flex items-center justify-center transition-colors" aria-label="Toggle complete"> <i data-lucide="check" style="width:14px;height:14px;display:none" class="check-icon text-white"></i> </button>
    <div class="flex-1 min-w-0"><span data-template-id="item-name-text" class="canva-text item-text font-medium text-sm block truncate"></span> <span data-template-id="item-meta-text" class="canva-text text-xs opacity-60"></span>
    </div><button type="button" class="del-btn opacity-0 group-hover:opacity-100 transition-opacity text-red-400 hover:text-red-600" aria-label="Delete item"> <i data-lucide="trash-2" style="width:16px;height:16px"></i> </button>
   </div>
  </template>
  <script src="/_sdk/data_sdk.js"></script>
  <script src="/_sdk/editing_sdk.js"></script>
  <script>
        let allData = [];
        const list = document.getElementById('grocery-list');
        const emptyEl = document.getElementById('empty-state');
        const limitEl = document.getElementById('limit-warning');
        const form = document.getElementById('add-form');
        const tpl = document.getElementById('item-tpl');

        const CATS = ['Produce','Dairy','Meat','Bakery','Frozen','Beverages','Other'];
        const CAT_EMOJI = {Produce:'🥬',Dairy:'🧀',Meat:'🥩',Bakery:'🍞',Frozen:'🧊',Beverages:'🥤',Other:'📦'};

        function render(data) {
            allData = data;
            emptyEl.classList.toggle('hidden', data.length > 0);
            const existing = new Map([...list.children].map(el => [el.dataset.rid, el]));
            const order = [...data].sort((a,b) => {
                if (a.completed !== b.completed) return a.completed ? 1 : -1;
                return CATS.indexOf(a.category) - CATS.indexOf(b.category);
            });
            const seen = new Set();
            let prev = null;
            order.forEach(item => {
                seen.add(item.__backendId);
                let el = existing.get(item.__backendId);
                if (!el) {
                    const clone = tpl.content.cloneNode(true);
                    el = clone.firstElementChild;
                    el.dataset.rid = item.__backendId;
                    el.querySelector('.check-btn').addEventListener('click', () => toggleItem(item.__backendId));
                    el.querySelector('.del-btn').addEventListener('click', () => deleteItem(item.__backendId));
                    lucide.createIcons();
                }
                updateEl(el, item);
                if (prev) prev.after(el); else list.prepend(el);
                prev = el;
            });
            existing.forEach((el, id) => { if (!seen.has(id)) el.remove(); });
            lucide.createIcons();
        }

        function updateEl(el, item) {
            el.querySelector('[data-template-id="item-name-text"]').textContent = item.item_name;
            el.querySelector('[data-template-id="item-meta-text"]').textContent = `${CAT_EMOJI[item.category]||''} ${item.category}${item.quantity ? ' · ' + item.quantity : ''}`;
            const btn = el.querySelector('.check-btn');
            const icon = btn.querySelector('.check-icon');
            if (item.completed) {
                el.classList.add('item-done');
                btn.style.background = '#34d399';
                btn.style.borderColor = '#34d399';
                icon.style.display = '';
            } else {
                el.classList.remove('item-done');
                btn.style.background = 'transparent';
                btn.style.borderColor = '#34d399';
                icon.style.display = 'none';
            }
        }

        async function toggleItem(id) {
            const item = allData.find(d => d.__backendId === id);
            if (!item) return;
            await window.dataSdk.update({...item, completed: !item.completed});
        }

        async function deleteItem(id) {
            const item = allData.find(d => d.__backendId === id);
            if (!item) return;
            const el = list.querySelector(`[data-rid="${id}"]`);
            if (el) el.style.opacity = '0.4';
            const r = await window.dataSdk.delete(item);
            if (!r.isOk && el) el.style.opacity = '';
        }

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (allData.length >= 999) { limitEl.classList.remove('hidden'); return; }
            const name = document.getElementById('item-name').value.trim();
            if (!name) return;
            const btn = form.querySelector('button[type=submit]');
            btn.disabled = true;
            const r = await window.dataSdk.create({
                item_name: name,
                category: document.getElementById('item-cat').value,
                quantity: document.getElementById('item-qty').value.trim() || '',
                completed: false
            });
            btn.disabled = false;
            if (r.isOk) { document.getElementById('item-name').value = ''; document.getElementById('item-qty').value = ''; }
        });

        (async () => {
            const r = await window.dataSdk.init({ onDataChanged: render });
            if (!r.isOk) console.error('SDK init failed');
            lucide.createIcons();
        })();
    </script>
