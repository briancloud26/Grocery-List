<!doctype html>
<html lang="en"><head><script src="/_sdk/telemetry_sdk.js"></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Data Manager</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&amp;display=swap" rel="stylesheet">
  <style>
        body { font-family: 'DM Sans', sans-serif; }
    </style>
  <script src="/_sdk/resizing_sdk.js" type="text/javascript"></script>
 </head>
 <body data-template-id="__page-root" class="min-h-screen" style="background: rgb(248, 250, 252);">
  <header class="border-b border-slate-200 px-6 py-5">
   <h1 data-template-id="page-title" class="canva-text font-bold" style="color: rgb(15, 23, 42); font-weight: 700; font-style: normal; font-size: 32px;">Data Manager</h1>
   <p data-template-id="page-subtitle" class="canva-text mt-1" style="color: rgb(100, 116, 139); font-weight: 400; font-style: normal; font-size: 14px;">Add, edit, and manage your records</p>
  </header>
  <main class="max-w-4xl mx-auto p-6">
   <form id="add-form" class="canva-card rounded-xl p-5 mb-6" data-template-id="form-section" style="background: rgb(255, 255, 255);">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
     <div><label data-template-id="label-name" class="canva-text block text-sm mb-1 font-medium" for="field-name" style="color: rgb(51, 65, 85); font-weight: 400; font-style: normal; font-size: 16px;">Name</label> <input id="field-name" type="text" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500" required="">
     </div>
     <div><label data-template-id="label-value" class="canva-text block text-sm mb-1 font-medium" for="field-value" style="color: rgb(51, 65, 85); font-weight: 400; font-style: normal; font-size: 16px;">Value</label> <input id="field-value" type="text" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500" required="">
     </div>
     <div><label data-template-id="label-category" class="canva-text block text-sm mb-1 font-medium" for="field-category" style="color: rgb(51, 65, 85); font-weight: 400; font-style: normal; font-size: 16px;">Category</label> <input id="field-category" type="text" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-teal-500">
     </div>
    </div><button data-template-id="add-button" type="submit" class="canva-button px-5 py-2 rounded-lg font-medium text-sm" style="background: rgb(13, 148, 136); color: rgb(255, 255, 255); font-weight: 500; font-style: normal; font-size: 16px;">Add Record</button>
   </form>
   <div id="record-count" class="text-sm text-slate-500 mb-3"></div>
   <div id="records-container" class="space-y-2"></div>
   <p data-template-id="empty-state" id="empty-state" class="canva-text text-center py-12" style="color: rgb(148, 163, 184); font-weight: 400; font-style: italic; font-size: 16px;">No records yet. Add one above!</p>
   <div id="limit-warning" class="hidden bg-amber-50 border border-amber-300 text-amber-800 rounded-lg p-3 text-sm mb-4"></div>
  </main>
  <template id="record-template">
   <div data-template-id="record-card" class="canva-card rounded-lg p-4 flex items-center justify-between gap-3">
    <div class="flex-1 min-w-0">
     <div class="flex items-center gap-2"><span class="record-name font-medium text-slate-900 truncate"></span> <span class="record-category text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full"></span>
     </div>
     <p class="record-value text-sm text-slate-500 mt-0.5 truncate"></p>
    </div>
    <div class="flex gap-1 record-actions"><button type="button" class="edit-btn p-1.5 rounded hover:bg-slate-100 text-slate-400 hover:text-teal-600"><i data-lucide="edit" style="width:16px;height:16px"></i></button> <button type="button" class="delete-btn p-1.5 rounded hover:bg-slate-100 text-slate-400 hover:text-red-500"><i data-lucide="trash-2" style="width:16px;height:16px"></i></button>
    </div>
    <div class="hidden confirm-actions flex gap-1"><button type="button" class="confirm-delete-btn text-xs bg-red-500 text-white px-3 py-1 rounded">Delete</button> <button type="button" class="cancel-delete-btn text-xs bg-slate-200 text-slate-700 px-3 py-1 rounded">Cancel</button>
    </div>
   </div>
  </template>
  <script src="/_sdk/editing_sdk.js"></script>
  <script src="/_sdk/data_sdk.js"></script>
  <script>
        let records = [];

        const container = document.getElementById('records-container');
        const emptyState = document.getElementById('empty-state');
        const countEl = document.getElementById('record-count');
        const limitWarning = document.getElementById('limit-warning');
        const form = document.getElementById('add-form');

        function renderRecords() {
            const existing = new Map([...container.children].map(el => [el.dataset.id, el]));
            const currentIds = new Set(records.map(r => r.__backendId));

            existing.forEach((el, id) => { if (!currentIds.has(id)) el.remove(); });

            records.forEach(record => {
                if (existing.has(record.__backendId)) {
                    const el = existing.get(record.__backendId);
                    el.querySelector('.record-name').textContent = record.name || '';
                    el.querySelector('.record-value').textContent = record.value || '';
                    el.querySelector('.record-category').textContent = record.category || '';
                } else {
                    const tmpl = document.getElementById('record-template');
                    const clone = tmpl.content.cloneNode(true);
                    const card = clone.firstElementChild;
                    card.dataset.id = record.__backendId;
                    card.querySelector('.record-name').textContent = record.name || '';
                    card.querySelector('.record-value').textContent = record.value || '';
                    card.querySelector('.record-category').textContent = record.category || '';

                    card.querySelector('.edit-btn').addEventListener('click', () => startEdit(record, card));
                    card.querySelector('.delete-btn').addEventListener('click', () => {
                        card.querySelector('.record-actions').classList.add('hidden');
                        card.querySelector('.confirm-actions').classList.remove('hidden');
                    });
                    card.querySelector('.cancel-delete-btn').addEventListener('click', () => {
                        card.querySelector('.confirm-actions').classList.add('hidden');
                        card.querySelector('.record-actions').classList.remove('hidden');
                    });
                    card.querySelector('.confirm-delete-btn').addEventListener('click', () => deleteRecord(record, card));

                    container.appendChild(card);
                    lucide.createIcons();
                }
            });

            emptyState.classList.toggle('hidden', records.length > 0);
            countEl.textContent = records.length > 0 ? `${records.length} record${records.length !== 1 ? 's' : ''}` : '';
        }

        async function startEdit(record, card) {
            const content = card.querySelector('.flex-1');
            const prev = content.innerHTML;
            content.innerHTML = `
                <input class="edit-name border border-slate-300 rounded px-2 py-1 text-sm w-full mb-1" value="${(record.name||'').replace(/"/g,'&quot;')}">
                <input class="edit-value border border-slate-300 rounded px-2 py-1 text-sm w-full mb-1" value="${(record.value||'').replace(/"/g,'&quot;')}">
                <input class="edit-category border border-slate-300 rounded px-2 py-1 text-sm w-full" value="${(record.category||'').replace(/"/g,'&quot;')}">
                <div class="mt-2 flex gap-2">
                    <button type="button" class="save-edit text-xs bg-teal-600 text-white px-3 py-1 rounded">Save</button>
                    <button type="button" class="cancel-edit text-xs bg-slate-200 text-slate-700 px-3 py-1 rounded">Cancel</button>
                </div>`;
            content.querySelector('.cancel-edit').addEventListener('click', () => { content.innerHTML = prev; });
            content.querySelector('.save-edit').addEventListener('click', async () => {
                const btn = content.querySelector('.save-edit');
                btn.textContent = '...'; btn.disabled = true;
                const updated = { ...record, name: content.querySelector('.edit-name').value, value: content.querySelector('.edit-value').value, category: content.querySelector('.edit-category').value };
                const res = await window.dataSdk.update(updated);
                if (!res.isOk) { btn.textContent = 'Error'; btn.disabled = false; }
            });
        }

        async function deleteRecord(record, card) {
            const btn = card.querySelector('.confirm-delete-btn');
            btn.textContent = '...'; btn.disabled = true;
            const res = await window.dataSdk.delete(record);
            if (!res.isOk) { btn.textContent = 'Error'; btn.disabled = false; }
        }

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (records.length >= 999) { limitWarning.textContent = 'Limit of 999 records reached.'; limitWarning.classList.remove('hidden'); return; }
            const btn = form.querySelector('button[type="submit"]');
            btn.disabled = true; btn.style.opacity = '0.5';
            const res = await window.dataSdk.create({
                name: document.getElementById('field-name').value,
                value: document.getElementById('field-value').value,
                category: document.getElementById('field-category').value || '',
                created_at: new Date().toISOString()
            });
            btn.disabled = false; btn.style.opacity = '1';
            if (res.isOk) form.reset();
        });

        const handler = {
            onDataChanged(data) {
                records = data;
                renderRecords();
            }
        };

        (async () => {
            await window.dataSdk.init(handler);
            lucide.createIcons();
        })();
    </script>
