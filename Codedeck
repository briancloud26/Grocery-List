<!doctype html>
<html lang="en"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Human Migration Data</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <script src="/_sdk/editing_sdk.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Fraunces:opsz,wght@9..144,600;9..144,700&amp;display=swap" rel="stylesheet">
  <style>
    :root{
      --ink:#18211d;
      --muted:#6d746f;
      --paper:#f4f1ea;
      --line:#d8d2c7;
      --forest:#173f31;
      --forest-2:#2a6550;
      --cream:#fbfaf6;
      --sage:#dde8dc;
      --sand:#eee3d2;
      --bluegrey:#e6eaec;
    }
    *{box-sizing:border-box}
    body{margin:0;font-family:'DM Sans',sans-serif;color:var(--ink);min-width:320px}
    .display-font{font-family:'Fraunces',serif}
    .app-shell{
      width:100%;
      min-height:calc(100 * min(var(--vh, 1vh), 1vh));
      background:
        radial-gradient(circle at 82% 7%, rgba(210,222,211,.62), transparent 24%),
        radial-gradient(circle at 5% 12%, rgba(255,255,255,.85), transparent 20%),
        linear-gradient(135deg,#f7f4ed 0%,#eee8dd 100%);
    }
    .noise{
      background-image:radial-gradient(rgba(23,33,28,.035) 1px,transparent 1px);
      background-size:18px 18px;
    }
    .glass-card{
      background:rgba(251,250,246,.9);
      backdrop-filter:blur(14px);
      border:1px solid rgba(216,210,199,.9);
      box-shadow:0 18px 52px rgba(31,41,35,.075);
    }
    .focus-ring:focus-visible{outline:3px solid rgba(37,88,70,.28);outline-offset:2px}
    .metric-card{transition:transform .25s ease, box-shadow .25s ease}
    .metric-card:hover{transform:translateY(-3px);box-shadow:0 22px 58px rgba(31,41,35,.11)}
    .table-scroll::-webkit-scrollbar{height:8px}
    .table-scroll::-webkit-scrollbar-thumb{background:#c8c0b4;border-radius:999px}
    .bar-track{background:#edf0eb}
    .bar-fill{background:linear-gradient(90deg,#214c3d,#7ca38b)}
    .row-enter{animation:rowIn .28s ease both}
    @keyframes rowIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
  </style>
  <script src="/_sdk/resizing_sdk.js" type="text/javascript"></script>
  <script src="/_sdk/data_sdk.js" type="text/javascript"></script>
 <script src="/_sdk/telemetry_sdk.js"></script></head>
 <body data-template-id="__page-root" style="background: linear-gradient(135deg, rgb(247, 244, 237), rgb(239, 233, 222));">
  <div class="app-shell noise w-full">
   <header class="w-full px-5 sm:px-8 lg:px-10 pt-8 lg:pt-10">
    <div class="max-w-7xl mx-auto">
     <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
      <div>
       <p data-template-id="hero-kicker" class="canva-text uppercase tracking-[0.22em] text-xs font-semibold mb-3" style="color: rgb(109, 119, 111); font-weight: 700; font-style: normal; font-size: 11px; letter-spacing: 0.18rem;">Global movement / 2024</p>
       <h1 data-template-id="dashboard-title" class="canva-text display-font leading-[1.03] max-w-4xl" style="color: rgb(23, 63, 49); font-weight: 700; font-style: normal; font-size: 54px; line-height: 1.02;">Human movement, mapped in numbers.</h1>
       <p data-template-id="dashboard-subtitle" class="canva-text mt-4 max-w-2xl leading-7" style="color: rgb(102, 113, 105); font-weight: 400; font-style: normal; font-size: 17px; line-height: 1.6;">A clear, data-led view of where people move, settle and reshape the world around them.</p>
      </div>
      <div data-template-id="dataset-badge" class="canva-tag inline-flex items-center gap-2 rounded-full border border-[#cfd8cf] bg-[#eef4ed] px-4 py-2 text-sm font-semibold text-[#315c49] self-start lg:self-auto" style="background: rgb(238, 244, 237); color: rgb(49, 92, 73); font-weight: 700; font-style: normal; font-size: 15px;">Global migration dataset</div>
     </div>
    </div>
   </header>
   <main class="w-full px-5 sm:px-8 lg:px-10 pb-10">
    <div class="max-w-7xl mx-auto">
     <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 mt-10" aria-label="Migration summary">
      <article data-template-id="metric-card-1" class="canva-card metric-card glass-card rounded-[22px] p-5" style="background: rgb(251, 250, 246);">
       <div class="flex items-start justify-between gap-4">
        <div>
         <p data-template-id="metric-total-label" class="canva-text text-sm font-medium" style="color: rgb(107, 116, 111); font-weight: 600; font-style: normal; font-size: 15px;">Total migrants</p>
         <p id="metric-total" class="display-font text-3xl mt-3 text-[#173f31]">0</p>
        </div><span class="w-10 h-10 rounded-full bg-[#e1eadf] flex items-center justify-center text-[#255846]"><i data-lucide="users" class="w-5 h-5"></i></span>
       </div>
      </article>
      <article data-template-id="metric-card-2" class="canva-card metric-card glass-card rounded-[22px] p-5" style="background: rgb(251, 250, 246);">
       <div class="flex items-start justify-between gap-4">
        <div>
         <p data-template-id="metric-destination-label" class="canva-text text-sm font-medium" style="color: rgb(107, 116, 111); font-weight: 600; font-style: normal; font-size: 15px;">Top destination</p>
         <p id="metric-destination" class="display-font text-3xl mt-3 text-[#173f31]">—</p>
        </div><span class="w-10 h-10 rounded-full bg-[#eee3d2] flex items-center justify-center text-[#8a693e]"><i data-lucide="map-pinned" class="w-5 h-5"></i></span>
       </div>
      </article>
      <article data-template-id="metric-card-3" class="canva-card metric-card glass-card rounded-[22px] p-5" style="background: rgb(251, 250, 246);">
       <div class="flex items-start justify-between gap-4">
        <div>
         <p data-template-id="metric-inflow-label" class="canva-text text-sm font-medium" style="color: rgb(107, 116, 111); font-weight: 600; font-style: normal; font-size: 15px;">Highest net inflow</p>
         <p id="metric-inflow" class="display-font text-3xl mt-3 text-[#173f31]">0</p>
        </div><span class="w-10 h-10 rounded-full bg-[#e4e1ee] flex items-center justify-center text-[#675a86]"><i data-lucide="arrow-down-to-line" class="w-5 h-5"></i></span>
       </div>
      </article>
      <article data-template-id="metric-card-4" class="canva-card metric-card glass-card rounded-[22px] p-5" style="background: rgb(251, 250, 246);">
       <div class="flex items-start justify-between gap-4">
        <div>
         <p data-template-id="metric-change-label" class="canva-text text-sm font-medium" style="color: rgb(107, 116, 111); font-weight: 600; font-style: normal; font-size: 15px;">Year-over-year</p>
         <p id="metric-change" class="display-font text-3xl mt-3 text-[#173f31]">+0%</p>
        </div><span class="w-10 h-10 rounded-full bg-[#e6eaec] flex items-center justify-center text-[#566a72]"><i data-lucide="trending-up" class="w-5 h-5"></i></span>
       </div>
      </article>
     </section>
     <section class="grid grid-cols-1 lg:grid-cols-[1.35fr_.85fr] gap-6 mt-6">
      <section data-template-id="flow-panel" class="canva-panel glass-card rounded-[28px] p-5 sm:p-6 lg:p-7" style="background: rgb(251, 250, 246);">
       <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
         <h2 data-template-id="flow-title" class="canva-text display-font" style="color: rgb(23, 63, 49); font-weight: 700; font-style: normal; font-size: 23px;">Largest migration flows</h2>
         <p data-template-id="flow-subtitle" class="canva-text mt-2" style="color: rgb(115, 123, 117); font-weight: 400; font-style: normal; font-size: 14px;">Top destinations ranked by net migration for the selected year.</p>
        </div>
        <div class="flex items-center gap-2 text-sm text-[#6b746f]"><span class="w-3 h-3 rounded-full bg-[#255846]"></span> <span>Net migration</span>
        </div>
       </div>
       <div id="flow-bars" class="space-y-5"></div>
      </section>
      <aside data-template-id="context-panel" class="canva-panel glass-card rounded-[28px] overflow-hidden" style="background: rgb(251, 250, 246);">
       <div class="h-48 overflow-hidden"><img data-template-id="context-image" loading="lazy" class="canva-image w-full h-full object-cover" src="https://images.pexels.com/photos/12717174/pexels-photo-12717174.jpeg" alt="Passengers walking and seated in a bustling Hong Kong airport terminal.">
       </div>
       <div class="p-5 sm:p-6">
        <p data-template-id="context-kicker" class="canva-text uppercase tracking-[0.18em] text-[11px] font-semibold mb-3" style="color: rgb(124, 133, 126); font-weight: 700; font-style: normal; font-size: 11px; letter-spacing: 0.16rem;">Context note</p>
        <h2 data-template-id="context-title" class="canva-text display-font leading-tight" style="color: rgb(23, 63, 49); font-weight: 700; font-style: normal; font-size: 25px; line-height: 1.15;">Migration is both global and deeply local.</h2>
        <p data-template-id="context-copy" class="canva-text mt-3 leading-6" style="color: rgb(104, 114, 107); font-weight: 400; font-style: normal; font-size: 14px; line-height: 1.6;">Behind every line of data are family decisions, labor markets, border policies and the search for stability.</p>
       </div>
      </aside>
     </section>
     <section data-template-id="records-panel" class="canva-panel glass-card rounded-[28px] mt-6 overflow-hidden" style="background: rgb(251, 250, 246);">
      <div class="p-5 sm:p-6 lg:p-7 border-b border-[#ded7cb]">
       <div class="flex flex-col xl:flex-row xl:items-end xl:justify-between gap-5">
        <div>
         <h2 data-template-id="records-title" class="canva-text display-font" style="color: rgb(23, 63, 49); font-weight: 700; font-style: normal; font-size: 23px;">Country migration table</h2>
         <p data-template-id="records-subtitle" class="canva-text mt-2" style="color: rgb(115, 123, 117); font-weight: 400; font-style: normal; font-size: 14px;">Search and compare migration patterns across major destination countries.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 w-full xl:w-auto">
         <div class="w-full sm:w-72"><label data-template-id="search-label" for="search-input" class="canva-text block text-xs font-semibold uppercase tracking-[0.14em] mb-2" style="color: rgb(119, 128, 120); font-weight: 700; font-style: normal; font-size: 11px; letter-spacing: 0.12rem;">Search</label>
          <div class="relative"><i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-[#7e877f]"></i> <input id="search-input" data-template-id="search-input" class="canva-input focus-ring w-full rounded-xl border border-[#d8d2c7] bg-[#fffdf8] pl-10 pr-3 py-3 text-sm outline-none transition" type="text" placeholder="Country or region" style="color: rgb(23, 63, 49); font-weight: 400; font-style: normal; font-size: 15px;">
          </div>
         </div>
         <div class="w-full sm:w-40"><label data-template-id="year-label" for="year-filter" class="canva-text block text-xs font-semibold uppercase tracking-[0.14em] mb-2" style="color: rgb(119, 128, 120); font-weight: 700; font-style: normal; font-size: 11px; letter-spacing: 0.12rem;">Year</label> <select id="year-filter" class="focus-ring w-full rounded-xl border border-[#d8d2c7] bg-[#fffdf8] px-3 py-3 text-sm outline-none transition"> <option value="2024">2024</option> <option value="2023">2023</option> <option value="2022">2022</option> </select>
         </div>
         <div class="w-full sm:w-auto self-end"><button id="sort-toggle" data-template-id="sort-button" class="canva-button focus-ring inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl px-4 py-3 text-sm font-semibold transition" type="button" style="background: rgb(23, 63, 49); color: rgb(255, 255, 255); font-weight: 700; font-style: normal; font-size: 15px;">Sort by net</button>
         </div>
        </div>
       </div>
      </div>
      <div id="empty-state" class="hidden px-6 py-16 text-center">
       <div class="w-14 h-14 rounded-full bg-[#e6ecdf] flex items-center justify-center mx-auto text-[#255846]"><i data-lucide="table-2" class="w-6 h-6"></i>
       </div>
       <h3 data-template-id="empty-state-title" class="canva-text display-font mt-5" style="color: rgb(23, 63, 49); font-weight: 700; font-style: normal; font-size: 18px;">No countries found</h3>
       <p data-template-id="empty-state-copy" class="canva-text mt-2 max-w-md mx-auto" style="color: rgb(115, 123, 117); font-weight: 400; font-style: normal; font-size: 14px; line-height: 1.5;">Try a different country, region or year to explore the dataset.</p>
      </div>
      <div id="table-wrap" class="table-scroll overflow-x-auto">
       <table class="w-full min-w-[980px] border-collapse">
        <thead>
         <tr class="border-b border-[#e2dbcf] text-left bg-[#f7f5ef]">
          <th class="px-6 py-4 text-xs uppercase tracking-[0.14em] font-semibold text-[#6b746f]">Country</th>
          <th class="px-4 py-4 text-xs uppercase tracking-[0.14em] font-semibold text-[#6b746f]">Region</th>
          <th class="px-4 py-4 text-xs uppercase tracking-[0.14em] font-semibold text-[#6b746f]">Inbound</th>
          <th class="px-4 py-4 text-xs uppercase tracking-[0.14em] font-semibold text-[#6b746f]">Outbound</th>
          <th class="px-4 py-4 text-xs uppercase tracking-[0.14em] font-semibold text-[#6b746f]">Net</th>
          <th class="px-4 py-4 text-xs uppercase tracking-[0.14em] font-semibold text-[#6b746f]">Global share</th>
          <th class="px-6 py-4 text-xs uppercase tracking-[0.14em] font-semibold text-[#6b746f]">Year</th>
         </tr>
        </thead>
        <tbody id="migration-body"></tbody>
       </table>
      </div>
     </section>
    </div>
   </main>
  </div>
  <template id="migration-row-template">
   <tr class="migration-row row-enter border-b border-[#ece6dc] last:border-0 bg-[#fffdfa]">
    <td class="px-6 py-5">
     <div class="font-semibold text-[#20342b] country-cell"></div></td>
    <td class="px-4 py-5 text-sm text-[#59625c] region-cell"></td>
    <td class="px-4 py-5 text-sm text-[#20342b] inbound-cell"></td>
    <td class="px-4 py-5 text-sm text-[#20342b] outbound-cell"></td>
    <td class="px-4 py-5"><span class="net-cell inline-flex rounded-full px-3 py-1 text-xs font-semibold"></span></td>
    <td class="px-4 py-5 text-sm text-[#59625c] share-cell"></td>
    <td class="px-6 py-5 text-sm text-[#59625c] year-cell"></td>
   </tr>
  </template>
  <script>
    const migrationData = [
      {country:'United States', region:'North America', inbound:50600000, outbound:3000000, net:47600000, share:17.8, year:2024},
      {country:'Germany', region:'Europe', inbound:16700000, outbound:4200000, net:12500000, share:5.9, year:2024},
      {country:'Saudi Arabia', region:'Middle East', inbound:13700000, outbound:450000, net:13250000, share:4.8, year:2024},
      {country:'United Kingdom', region:'Europe', inbound:9800000, outbound:4700000, net:5100000, share:3.4, year:2024},
      {country:'Canada', region:'North America', inbound:8600000, outbound:1400000, net:7200000, share:3.0, year:2024},
      {country:'Australia', region:'Oceania', inbound:7900000, outbound:650000, net:7250000, share:2.8, year:2024},
      {country:'France', region:'Europe', inbound:8900000, outbound:2500000, net:6400000, share:3.1, year:2024},
      {country:'United Arab Emirates', region:'Middle East', inbound:9000000, outbound:320000, net:8680000, share:3.2, year:2024},
      {country:'Spain', region:'Europe', inbound:6900000, outbound:1800000, net:5100000, share:2.4, year:2024},
      {country:'Italy', region:'Europe', inbound:6500000, outbound:2900000, net:3600000, share:2.3, year:2024},

      {country:'United States', region:'North America', inbound:49800000, outbound:2900000, net:46900000, share:17.6, year:2023},
      {country:'Germany', region:'Europe', inbound:16200000, outbound:4100000, net:12100000, share:5.7, year:2023},
      {country:'Saudi Arabia', region:'Middle East', inbound:13300000, outbound:430000, net:12870000, share:4.7, year:2023},
      {country:'United Kingdom', region:'Europe', inbound:9500000, outbound:4600000, net:4900000, share:3.3, year:2023},
      {country:'Canada', region:'North America', inbound:8300000, outbound:1350000, net:6950000, share:2.9, year:2023},
      {country:'Australia', region:'Oceania', inbound:7600000, outbound:620000, net:6980000, share:2.7, year:2023},
      {country:'France', region:'Europe', inbound:8700000, outbound:2450000, net:6250000, share:3.0, year:2023},
      {country:'United Arab Emirates', region:'Middle East', inbound:8800000, outbound:310000, net:8490000, share:3.1, year:2023},
      {country:'Spain', region:'Europe', inbound:6600000, outbound:1750000, net:4850000, share:2.3, year:2023},
      {country:'Italy', region:'Europe', inbound:6300000, outbound:2850000, net:3450000, share:2.2, year:2023},

      {country:'United States', region:'North America', inbound:48900000, outbound:2850000, net:46050000, share:17.4, year:2022},
      {country:'Germany', region:'Europe', inbound:15800000, outbound:4000000, net:11800000, share:5.6, year:2022},
      {country:'Saudi Arabia', region:'Middle East', inbound:12900000, outbound:410000, net:12490000, share:4.6, year:2022},
      {country:'United Kingdom', region:'Europe', inbound:9200000, outbound:4500000, net:4700000, share:3.2, year:2022},
      {country:'Canada', region:'North America', inbound:8000000, outbound:1300000, net:6700000, share:2.8, year:2022},
      {country:'Australia', region:'Oceania', inbound:7300000, outbound:600000, net:6700000, share:2.6, year:2022},
      {country:'France', region:'Europe', inbound:8500000, outbound:2400000, net:6100000, share:2.9, year:2022},
      {country:'United Arab Emirates', region:'Middle East', inbound:8500000, outbound:300000, net:8200000, share:3.0, year:2022},
      {country:'Spain', region:'Europe', inbound:6400000, outbound:1700000, net:4700000, share:2.2, year:2022},
      {country:'Italy', region:'Europe', inbound:6100000, outbound:2800000, net:3300000, share:2.1, year:2022}
    ];

    const state = { search:'', year:'2024', sortDesc:true };
    const body = document.getElementById('migration-body');
    const emptyState = document.getElementById('empty-state');
    const tableWrap = document.getElementById('table-wrap');
    const flowBars = document.getElementById('flow-bars');
    const numberFmt = new Intl.NumberFormat('en-US');
    const shortFmt = new Intl.NumberFormat('en-US',{notation:'compact',maximumFractionDigits:1});

    function filteredRecords(){
      return migrationData
        .filter(r => String(r.year) === state.year)
        .filter(r => {
          const q = state.search.trim().toLowerCase();
          return !q || r.country.toLowerCase().includes(q) || r.region.toLowerCase().includes(q);
        })
        .sort((a,b) => state.sortDesc ? b.net-a.net : a.net-b.net);
    }

    function getNetClasses(value){
      return value >= 0
        ? 'bg-[#e1eadf] text-[#2c684f]'
        : 'bg-[#f2e0dc] text-[#96564d]';
    }

    function createRow(record){
      const frag = document.getElementById('migration-row-template').content.cloneNode(true);
      const row = frag.querySelector('.migration-row');
      row.dataset.key = record.country + '-' + record.year;
      updateRow(row, record);
      return row;
    }

    function updateRow(row, r){
      row.querySelector('.country-cell').textContent = r.country;
      row.querySelector('.region-cell').textContent = r.region;
      row.querySelector('.inbound-cell').textContent = numberFmt.format(r.inbound);
      row.querySelector('.outbound-cell').textContent = numberFmt.format(r.outbound);
      const net = row.querySelector('.net-cell');
      net.textContent = (r.net >= 0 ? '+' : '') + numberFmt.format(r.net);
      net.className = 'net-cell inline-flex rounded-full px-3 py-1 text-xs font-semibold ' + getNetClasses(r.net);
      row.querySelector('.share-cell').textContent = r.share.toFixed(1) + '%';
      row.querySelector('.year-cell').textContent = r.year;
    }

    function renderRows(){
      const records = filteredRecords();
      const existing = new Map([...body.children].map(r => [r.dataset.key, r]));

      records.forEach(record => {
        const key = record.country + '-' + record.year;
        if(existing.has(key)){
          const row = existing.get(key);
          updateRow(row, record);
          body.appendChild(row);
          existing.delete(key);
        }else{
          body.appendChild(createRow(record));
        }
      });

      existing.forEach(row => row.remove());

      emptyState.classList.toggle('hidden', records.length > 0);
      tableWrap.classList.toggle('hidden', records.length === 0);
    }

    function renderMetrics(){
      const records = filteredRecords();
      const totalInbound = records.reduce((sum,r)=>sum+r.inbound,0);
      const topDestination = records.length ? [...records].sort((a,b)=>b.inbound-a.inbound)[0].country : '—';
      const highestNet = records.length ? Math.max(...records.map(r=>r.net)) : 0;
      const selectedYear = Number(state.year);
      const currentTotal = migrationData.filter(r=>r.year===selectedYear).reduce((sum,r)=>sum+r.inbound,0);
      const previousTotal = migrationData.filter(r=>r.year===selectedYear-1).reduce((sum,r)=>sum+r.inbound,0);
      const change = previousTotal ? ((currentTotal-previousTotal)/previousTotal)*100 : 0;

      document.getElementById('metric-total').textContent = shortFmt.format(totalInbound);
      document.getElementById('metric-destination').textContent = topDestination;
      document.getElementById('metric-inflow').textContent = shortFmt.format(highestNet);
      document.getElementById('metric-change').textContent = (change >= 0 ? '+' : '') + change.toFixed(1) + '%';
    }

    function renderFlowBars(){
      const records = filteredRecords().slice(0,5);
      const max = Math.max(...records.map(r=>r.net),1);

      flowBars.innerHTML = records.map((r, index) => `
        <div class="space-y-2">
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="text-sm font-semibold text-[#20342b]">${r.country}</p>
              <p class="text-xs text-[#7b827d]">${r.region}</p>
            </div>
            <p class="text-sm font-semibold text-[#255846]">+${shortFmt.format(r.net)}</p>
          </div>
          <div class="bar-track h-3 rounded-full overflow-hidden">
            <div class="bar-fill h-full rounded-full transition-all duration-500" style="width:${Math.max(7,(r.net/max)*100)}%"></div>
